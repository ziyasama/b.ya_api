# ---------------------------------------------------------------------------
# Bosphorus Data Aggregation Hub — copy to .env.local (web/dev) or paste
# into the Railway dashboard. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server/worker only. NEVER import this in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Geographic focus (Bosphorus strait, Istanbul) ---
# Tight AIS box (the strait itself).
BOSPHORUS_LAT=41.04
BOSPHORUS_LON=29.01
BOSPHORUS_LAT_MIN=40.99
BOSPHORUS_LAT_MAX=41.24
BOSPHORUS_LON_MIN=28.95
BOSPHORUS_LON_MAX=29.15
# Wider AIS box sent alongside the tight box (Marmara -> strait -> Black Sea
# approaches). AISStream is event-driven; the tight box can sit silent for
# minutes, so the worker subscribes to both boxes together. /map renders
# both from these same values.
BOSPHORUS_APPROACH_LAT_MIN=40.85
BOSPHORUS_APPROACH_LAT_MAX=41.4
BOSPHORUS_APPROACH_LON_MIN=28.7
BOSPHORUS_APPROACH_LON_MAX=29.4

# Wave and SST sample point. Deliberately NOT the strait: the marine wave
# model has no cell inside the Bosphorus, so a strait request snaps ~9 km
# south into the Marmara and returns an inshore near-zero (0.04 m, measured
# 2 Sep 2026). This point is open Black Sea water at the northern mouth,
# which reads 0.4 m and is also the water that flows south through the strait.
# These are the model cell's own coordinates, so the displacement reported by
# `npm run check:sources` stays near zero and a real snap stands out.
BOSPHORUS_WAVE_LAT=41.375
BOSPHORUS_WAVE_LON=29.125

# --- Map (CARTO basemaps — free key at https://carto.com/basemaps/apikey) ---
NEXT_PUBLIC_CARTO_API_KEY=

# --- Open-Meteo (no key required for the public API) ---
# Modelled. Waves and SST at the mouth; wind only as a fallback behind METAR.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_POLL_MS=900000

# --- METAR (measured wind, free, no key, no registration) ---
# Istanbul airport anemometers. The model reported 2.97 m/s at the strait
# while these read 5.1-6.2 m/s, so measured wins and the model fills gaps.
METAR_URL=https://aviationweather.gov/api/data/metar
METAR_STATIONS=LTFM,LTBA,LTFJ
METAR_POLL_MS=600000
# Reject observations older than this rather than publish them as current.
METAR_MAX_AGE_MS=5400000

# --- IOC Sea Level Monitoring (measured, free, no key) ---
# Tide gauges either side of the strait. Black Sea minus Marmara head is the
# physical driver of the surface flow, and replaces the current velocities
# that were null in every row ever written.
# `ista` sits inside the strait but stopped reporting 17 Aug 2026.
SEA_LEVEL_URL=https://www.ioc-sealevelmonitoring.org/service.php
SEA_LEVEL_BLACK_SEA_CODE=sile
SEA_LEVEL_MARMARA_CODE=yalo
SEA_LEVEL_BLACK_SEA_BACKUP=igne
SEA_LEVEL_MARMARA_BACKUP=maer
# The service returns a fixed ~2,100 rows for any window, so a short window
# buys resolution rather than a smaller payload. The head moves over hours.
SEA_LEVEL_POLL_MS=300000
# Gauges sit on differing local datums, so each is compared to its own mean.
SEA_LEVEL_BASELINE_HOURS=24
SEA_LEVEL_BASELINE_TTL_MS=21600000
# Per-poll window in days. Gauges sample every ~6 s, so keep this small.
SEA_LEVEL_WINDOW_DAYS=0.01

# --- AISStream.io ---
AISSTREAM_API_KEY=your-aisstream-api-key
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
AIS_SNAPSHOT_MS=30000
AIS_STALE_MS=900000
# Grace period after the subscription confirms. AISStream pushes only when a
# vessel transmits, so an empty roster this early is a silent feed, not an
# empty strait, and is reported as unavailable instead of as zero.
AIS_WARMUP_MS=60000
VESSEL_ROSTER_SAVE_MS=120000
# Flush detected lighthouse-line crossings. Faster than the state snapshot
# so a percussive voice can fire on the event rather than a drifting count.
VESSEL_EVENT_FLUSH_MS=10000

# --- Worker ---
# 120 s, not 30 s: no source updates faster than the sea level gauges, and
# 30 s produced four near-identical rows a minute.
WORKER_PERSIST_MS=120000
LOG_LEVEL=info

# --- OSC / MIDI (installation machine or radio container — not the web service) ---
OSC_HOST=127.0.0.1
OSC_PORT=57121
MIDI_PORT_NAME=Bosphorus Hub
OSC_MIDI_DRY_RUN=true
BROADCAST_POLL_MS=10000

# --- Radio container (Icecast). Invent these; never commit real values. ---
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
