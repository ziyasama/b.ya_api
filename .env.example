# ---------------------------------------------------------------------------
# Bosphorus Data Aggregation Hub — copy to .env.local (web/dev) or paste
# into the Railway dashboard. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server/worker only. NEVER import this in a client component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Geographic focus (Bosphorus strait, Istanbul) ---
# Tight AIS box (the strait itself).
BOSPHORUS_LAT=41.04
BOSPHORUS_LON=29.01
BOSPHORUS_LAT_MIN=40.99
BOSPHORUS_LAT_MAX=41.24
BOSPHORUS_LON_MIN=28.95
BOSPHORUS_LON_MAX=29.15
# Wider AIS box sent alongside the tight box (Marmara -> strait -> Black Sea
# approaches). AISStream is event-driven; the tight box can sit silent for
# minutes, so the worker subscribes to both boxes together. /map renders
# both from these same values.
BOSPHORUS_APPROACH_LAT_MIN=40.85
BOSPHORUS_APPROACH_LAT_MAX=41.4
BOSPHORUS_APPROACH_LON_MIN=28.7
BOSPHORUS_APPROACH_LON_MAX=29.4

# --- Map (CARTO basemaps — free key at https://carto.com/basemaps/apikey) ---
NEXT_PUBLIC_CARTO_API_KEY=

# --- Open-Meteo (no key required for the public API) ---
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_POLL_MS=300000

# --- AISStream.io ---
AISSTREAM_API_KEY=your-aisstream-api-key
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
AIS_SNAPSHOT_MS=30000
AIS_STALE_MS=900000

# --- Copernicus Marine (CMEMS) / EMODnet ---
# Official access is the Copernicus Marine Toolbox (Python). This Node
# worker uses optional ERDDAP JSON or a subset URL when configured.
CMEMS_USERNAME=
CMEMS_PASSWORD=
CMEMS_DATASET_ID=cmems_mod_med_phy_anfc_4.2km_P1H-m
CMEMS_PRODUCT_ID=
CMEMS_ERDDAP_URL=
CMEMS_POLL_MS=1800000

# --- Worker ---
WORKER_PERSIST_MS=30000
LOG_LEVEL=info

# --- OSC / MIDI (installation machine only — not Railway) ---
OSC_HOST=127.0.0.1
OSC_PORT=57121
MIDI_PORT_NAME=Bosphorus Hub
OSC_MIDI_DRY_RUN=true
BROADCAST_POLL_MS=10000
